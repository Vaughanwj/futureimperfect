# Copy to .env for local runs. In GitHub Actions these are repo secrets instead
# (Settings -> Secrets and variables -> Actions), never commit a real .env.

# --- Content locations (defaults are usually fine, override only if you move things) ---
# CLIPS_DIR=../clips
# SCHEDULE_CSV=../LITTOS_publer_schedule_PLAIN.csv
# PUBLISH_LOG_PATH=./state/publish_log.json
SITE_BASE_URL=https://futureimperfect.band
TIMEZONE=America/New_York
END_CARD_TRIM_SECONDS=10.0

# --- Instagram Graph API (Meta app: instagram_business_basic + instagram_business_content_publish) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# Only needed for the refresh-ig-token command / weekly refresh workflow:
META_APP_ID=
META_APP_SECRET=

# --- TikTok Content Posting API (inbox/draft flow) ---
# Not used by the default run - TikTok is handled natively via TikTok
# Studio's own scheduler (see automation/README.md). These are only
# consulted if TikTokInboxPublisher is re-added to ACTIVE_PLATFORMS in
# adapters/driving/cli.py.
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Set true to log what would happen without calling any real API
DRY_RUN=false
